# Root Logic Commerce on a VPS: one Caddy for every store domain, automatic TLS.
# Install to /etc/caddy/Caddyfile (setup.sh does this), then: systemctl reload caddy
{
	email {$ACME_EMAIL}
	# Certificates are issued only for domains a store owns (the app answers this check).
	on_demand_tls {
		ask http://127.0.0.1:3000/api/domains/check
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	# Next's hashed build assets never change: cache hard at the edge and in browsers.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output file /var/log/caddy/rlc.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
