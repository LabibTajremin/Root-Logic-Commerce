{
  "name": "root-logic-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/themes-gen.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "pnpm build:cov && node scripts/e2e-run.mjs",
    "build:cov": "node scripts/themes-gen.mjs && COVERAGE=1 next build --webpack",
    "e2e": "playwright test --trace off",
    "coverage:merge": "node scripts/coverage-merge.mjs",
    "verify": "node scripts/verify.mjs",
    "themes:gen": "node scripts/themes-gen.mjs",
    "db:migrate": "drizzle-kit migrate",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@electric-sql/pglite": "0.5.17",
    "@fontsource-variable/anek-bangla": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/hind-siliguri": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/tiro-bangla": "5.3.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "nodemailer": "^7.0.13",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "knip": "6.46.1",
    "monocart-coverage-reports": "3.2.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "vitest-monocart-coverage": "5.0.0"
  }
}
