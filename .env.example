# Required
DATABASE_URL=postgres://rlc:rlc@localhost:5432/rlc
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# vercel | vps  (vercel requires STORAGE_DRIVER=s3 or gdrive)
HOSTING_PROFILE=vps
# single | multi  (multi = one process serves many stores by Host header)
STORE_MODE=single
# Store served when STORE_MODE=single or the Host is unknown (defaults to store.config.ts slug)
DEFAULT_STORE_SLUG=
# local | s3 | gdrive  (overrides store.config.ts)
STORAGE_DRIVER=
# 32+ chars; encrypts credentials the owner saves in the admin panel (AES-GCM)
SETTINGS_KEY=
# Dev/e2e only: write OTP and other messages to this file instead of sending them.
# NOTIFY_LOG_FILE=.notify.log

# First boot only (idempotent): create the default store's owner login and domains.
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_PASSWORD=
# BOOTSTRAP_OWNER_NAME=Owner
# BOOTSTRAP_HOSTS=shop.example.com,www.shop.example.com
# Root Logic Lab's SUPER_ADMIN login (grants premium features to stores).
# BOOTSTRAP_SUPER_EMAIL=
# BOOTSTRAP_SUPER_PASSWORD=

# Media: local disk folder (VPS; Caddy serves it), or S3-compatible storage (Vercel: required).
# MEDIA_DIR=/var/lib/rlc/media
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Messages: Vercel Cron calls /api/cron/outbox with "Authorization: Bearer $CRON_SECRET".
# CRON_SECRET=
# MESSAGES_TRANSPORT=live
# Couriers (E1): 'log' makes up parcel references instead of calling Steadfast/Pathao/RedX.
# COURIER_TRANSPORT=live
# Ad pixels (H1/H2): 'log' records Meta / TikTok server events instead of sending them.
# TRACKING_TRANSPORT=live
